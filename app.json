{
  "expo": {
    "name": "Viraaj i10",
    "slug": "grand-i10-Nios",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/g-i10-App-icon-launcher.png",
    "scheme": "grandi10nios",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/g-i10-App-icon-launcher.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/g-i10-App-icon-launcher.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.sourav.grandi10Nios"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/g-i10-App-icon.png",
          "imageWidth": 144,
          "android": {
            "image": "./assets/images/g-i10-App-icon.png",
            "imageWidth": 144
          },
          "ios": {
            "image": "./assets/images/g-i10-App-icon.png",
            "imageWidth": 144
          }
        }
      ],
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": {
                "light": "#2563EB",
                "dark": "#60A5FA"
              },
              "colorControlActivated": {
                "light": "#2563EB",
                "dark": "#60A5FA"
              },
              "colorControlHighlight": {
                "light": "#E2E8F0",
                "dark": "#334155"
              },
              "textColorPrimary": {
                "light": "#0F172A",
                "dark": "#F8FAFC"
              },
              "textColorSecondary": {
                "light": "#475569",
                "dark": "#94A3B8"
              },
              "windowBackground": {
                "light": "#FFFFFF",
                "dark": "#1E1E1E"
              }
            },
            "timePicker": {
              "background": {
                "light": "#FFFFFF",
                "dark": "#1E1E1E"
              },
              "headerBackground": {
                "light": "#2563EB",
                "dark": "#1E293B"
              },
              "numbersBackgroundColor": {
                "light": "#F1F5F9",
                "dark": "#0F172A"
              },
              "numbersSelectorColor": {
                "light": "#2563EB",
                "dark": "#60A5FA"
              },
              "numbersTextColor": {
                "light": "#0F172A",
                "dark": "#F8FAFC"
              }
            }
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Viraaj i10 to use Face ID for secure login."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
